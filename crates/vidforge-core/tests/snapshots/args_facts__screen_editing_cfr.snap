全局   ffmpeg -hide_banner -nostdin -y -loglevel warning -progress pipe:1 -nostats
输入   -hwaccel auto -i D:\素材\录屏\Screen_Recording_20260901_213355.mp4
映射   -map 0:0 -map 0:1 -map_metadata 0
视频   -c:v libx264 -pix_fmt yuv420p -profile:v high -preset medium -crf 15 -g 30
帧率   -fps_mode:v cfr -r 60
音频   -c:a:0 copy
封装   -movflags +faststart -f mov
输出   D:\转码输出\Screen_Recording_20260901_213355_1080p_h264.mov
